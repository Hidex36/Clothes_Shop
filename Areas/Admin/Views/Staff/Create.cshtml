@model Clothes_shop.Models.Users

@{
    Layout = "_Layout";
}

<div class="container-fluid px-4 py-5">

    <div class="mb-4 border-bottom pb-2">
        <h2 class="fw-bold">Thêm nhân viên</h2>
    </div>

    <!-- 🔥 THÊM enctype -->
    <form asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="row g-4">

            <!-- LEFT -->
            <div class="col-md-6">
                <div class="card shadow-sm rounded-4 p-4 h-100">
                    <h5 class="mb-3 fw-bold">Thông tin cá nhân</h5>

                    <div class="mb-3">
                        <label>Họ tên</label>
                        <input asp-for="FullName" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Địa chỉ</label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Ngày sinh</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Giới tính</label>
                        <select asp-for="Sex" class="form-control">
                            <option value="">-- Chọn --</option>
                            <option value="1">Nam</option>
                            <option value="2">Nữ</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-md-6 d-flex flex-column gap-4">

                <!-- Avatar -->
                <div class="card shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-3">Ảnh đại diện</h5>

                    <img id="preview"
                         src="https://via.placeholder.com/150"
                         class="rounded-circle border mb-3"
                         style="width:120px;height:120px;object-fit:cover" />

                    <!-- 🔥 PHẢI có name -->
                    <input type="file" name="avatarFile" id="imageInput" class="form-control" />

                    <input asp-for="AvatarImageUrl" type="hidden" />
                </div>

                <!-- Account -->
                <div class="card shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-3">Tài khoản</h5>

                    <div class="mb-3">
                        <label>Email</label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Mật khẩu</label>
                        <input name="password" type="password" class="form-control" />
                    </div>
                </div>

            </div>

        </div>

        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-plus-circle"></i> Tạo nhân viên
            </button>

            <a asp-action="Index" class="btn btn-light border fw-semibold py-2">
                Hủy bỏ
            </a>
        </div>

    </form>
</div>

<script>
    const input = document.getElementById("imageInput");
    const preview = document.getElementById("preview");

    input.addEventListener("change", function () {
        const file = this.files[0];
        if (file) {
            preview.src = URL.createObjectURL(file);
        }
    });
</script>