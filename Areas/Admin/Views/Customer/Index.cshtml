@model IEnumerable<Clothes_shop.Models.Users>

@{
    Layout = "_Layout";
}

<div class="container-fluid px-4 py-5">
    <div class="d-flex justify-content-between align-items-end mb-4 pb-2 border-bottom">
        <div>
            <h1 class="fw-bolder display-6 text-dark mb-1">Quản Lý Khách Hàng</h1>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr class="text-primary text-uppercase small">
                        <th class="ps-4">Tên</th>
                        <th class="text-center">Ảnh</th>
                        <th class="text-center">Email</th>
                        <th class="text-center">Ngày sinh</th>
                        <th class="text-center">Giới tính</th>
                        <th class="text-center">Địa chỉ</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">
                                @(item.FullName ?? item.Email)
                            </td>

                            <td class="text-center">
                                <img src="@item.AvatarImageUrl"
                                     class="rounded-circle border shadow"
                                     style="width:60px;height:60px;object-fit:cover" />
                            </td>

                            <td class="text-center">@item.Email</td>

                            <td class="text-center">
                                @(item.DateOfBirth?.ToString("dd/MM/yyyy") ?? "N/A")
                            </td>

                            <td class="text-center">
                                @(item.Sex == 1 ? "Nam" : item.Sex == 2 ? "Nữ" : "Khác")
                            </td>

                            <td class="text-center">@item.Address</td>

                            <td class="text-center">
                                <form asp-action="Delete" asp-route-id="@item.Id">
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>