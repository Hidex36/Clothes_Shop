@model Clothes_shop.Models.Orders

@{
    Layout = "_Layout";
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="container-fluid px-4 py-4">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-link text-decoration-none text-muted p-0">
            <i class="bi bi-arrow-left-circle-fill me-2"></i>Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0">Thông tin khách hàng</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small text-uppercase">Tên người nhận</label>
                        <p class="fw-bold mb-0">@Model.Name</p>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small text-uppercase">Số điện thoại</label>
                        <p class="mb-0">@Model.ShippingPhone</p>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small text-uppercase">Địa chỉ giao hàng</label>
                        <p class="mb-0">@Model.ShippingAddress</p>
                    </div>
                    <hr>
                    <div class="mb-3">
                        <label class="text-muted small text-uppercase">Trạng thái hiện tại</label>
                        <div class="mt-1">
                            @if (Model.Status == OrderStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Chờ xử lý</span>
                            }
                            else if (Model.Status == OrderStatus.Confirmed)
                            {
                                <span class="badge bg-info">Đã xác nhận</span>
                            }
                            else if (Model.Status == OrderStatus.Completed)
                            {
                                <span class="badge bg-success">Hoàn thành</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Đã hủy</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Status == OrderStatus.Pending)
            {
                <form asp-action="Confirm" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-success btn-lg w-100 fw-bold shadow-sm rounded-3">
                        <i class="bi bi-check2-circle me-2"></i>XÁC NHẬN ĐƠN HÀNG
                    </button>
                </form>
            }
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Sản phẩm đã đặt</h5>
                    <span class="text-muted">Mã ĐH: #@Model.Id</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light small">
                                <tr>
                                    <th class="ps-4">Sản phẩm</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end pe-4">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                @* Giả sử bạn có trường ImageUrl trong Products *@
                                                <img src="@item.Product.ImageUrl" class="rounded-3 me-3" width="50" height="50" style="object-fit: cover;">
                                                <div>
                                                    <div class="fw-bold">@item.Product.Name</div>
                                                    <small class="text-muted">ID: @item.ProductId</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">x @item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("N0")đ</td>
                                        <td class="text-end fw-bold pe-4">@item.TotalPrice.ToString("N0")đ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold ps-4 py-3">TỔNG CỘNG:</td>
                                    <td class="text-end text-danger fw-bold fs-5 pe-4 py-3">
                                        @Model.OrderDetails.Sum(x => x.TotalPrice).ToString("N0")đ
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-4 {
        border-radius: 1rem !important;
    }

    .table th {
        border: none;
    }

    .badge {
        padding: 0.5em 1em;
        font-size: 0.85rem;
    }
</style>