@model IEnumerable<Clothes_shop.Models.Orders>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý đơn hàng";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Hệ Thống Đơn Hàng</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Admin</a></li>
                    <li class="breadcrumb-item active">Orders</li>
                </ol>
            </nav>
        </div>
        <div class="bg-white p-2 px-3 rounded-3 shadow-sm border">
            <span class="text-muted small">Hôm nay: <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong></span>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="icon-box bg-primary-subtle rounded-3 me-3 text-primary">
                    <i class="bi bi-mailbox2 fs-4"></i>
                </div>
                <h5 class="card-title mb-0 fw-bold">Đơn hàng mới chờ duyệt</h5>
            </div>
            <span class="badge bg-primary px-3 py-2 rounded-pill">
                @Model.Count(o => o.Status == OrderStatus.Pending) Đơn hàng
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase small fw-bold">
                        <tr>
                            <th class="ps-4">Mã ĐH</th>
                            <th>Thông tin khách</th>
                            <th>Địa chỉ giao hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Where(o => o.Status == OrderStatus.Pending))
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@order.Id</td>
                                <td>
                                    <div class="fw-bold">@order.Name</div>
                                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@order.ShippingPhone</div>
                                </td>
                                <td>
                                    <div class="text-truncate small" style="max-width: 200px;" title="@order.ShippingAddress">
                                        @order.ShippingAddress
                                    </div>
                                </td>
                                <td>@order.OrderDate.ToString("dd/MM HH:mm")</td>
                                <td class="fw-bold text-danger">
                                    @* Tính tổng tiền từ danh sách OrderDetails *@
                                    @(order.OrderDetails?.Sum(d => d.Quantity * d.UnitPrice).ToString("N0") ?? "0")đ
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">                                  
                                        <form asp-action="Confirm" asp-route-id="@order.Id" method="post">
                                            <button type="submit" class="btn btn-success btn-sm px-3 rounded-2 shadow-sm"
                                                    onclick="return confirm('Xác nhận duyệt đơn hàng này?')">
                                                <i class="bi bi-check-circle me-1"></i> Duyệt
                                            </button>
                                        </form>
                                        <a asp-action="Detail" asp-route-id="@order.Id" class="btn btn-outline-secondary btn-sm rounded-2">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 border-start border-4 border-success">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center">
                <div class="icon-box bg-success-subtle rounded-3 me-3 text-success">
                    <i class="bi bi-check-all fs-4"></i>
                </div>
                <h5 class="card-title mb-0 fw-bold">Lịch sử đơn hàng thành công</h5>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light small text-muted">
                        <tr>
                            <th class="ps-4">Mã ĐH</th>
                            <th>Khách hàng</th>
                            <th>Số điện thoại</th>
                            <th>Ngày hoàn tất</th>
                            <th>Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Where(o => o.Status == OrderStatus.Confirmed))
                        {
                            <tr class="bg-light-subtle">
                                <td class="ps-4 text-muted small">#@order.Id</td>
                                <td class="fw-medium">@order.Name</td>
                                <td class="small">@order.ShippingPhone</td>
                                <td class="small">@order.OrderDate.ToShortDateString()</td>
                                <td class="fw-bold text-success">
                                    @(order.OrderDetails?.Sum(d => d.Quantity * d.UnitPrice).ToString("N0") ?? "0")đ
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                        Đã hoàn tất
                                    </span>
                                    <a asp-action="Detail" asp-route-id="@order.Id" class="btn btn-outline-secondary btn-sm rounded-2">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-box {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-primary-subtle {
        background-color: #cfe2ff;
    }

    .bg-success-subtle {
        background-color: #d1e7dd;
    }

    .table thead th {
        border-top: none;
        color: #6c757d;
        font-size: 0.75rem;
    }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    .btn-sm {
        padding: 0.4rem 0.8rem;
    }
</style>