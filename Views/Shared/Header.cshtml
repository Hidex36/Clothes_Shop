
<header class="shadow-sm sticky-top bg-white">
	<nav class="navbar navbar-expand-lg navbar-light py-3">
		<div class="container-fluid px-5">
			<a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold fs-3 text-uppercase"  style="letter-spacing: 1px;">
				CLO<span class="text-primary">THES</span> SHOP
			</a>

			<button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav mx-auto">
					<li class="nav-item">
						<a asp-controller="Home" asp-action="Index" class="nav-link active fw-semibold px-3">Trang Chủ</a>
					</li>
					<li class="nav-item">
						<a asp-controller="Home" asp-action="About" class="nav-link fw-semibold px-3">Giới Thiệu</a>
					</li>

					@await Component.InvokeAsync("CategoryMenu", new { isHeader = true })

					<li class="nav-item">
						<a asp-controller="Home" asp-action="Contact" class="nav-link fw-semibold px-3">Liên Hệ</a>
					</li>
				</ul>

				<div class="d-flex align-items-center gap-3">
					<a href="#" class="text-dark position-relative">
						<i class="bi bi-search fs-5"></i>
					</a>
					<a asp-controller="Cart" asp-action="Index" class="text-dark position-relative">
						<i class="bi bi-cart fs-5"></i>
						@await Component.InvokeAsync("CartBadge")
					</a>
					<div class="d-flex align-items-center gap-3">
						<div class="dropdown custom-hover-menu">

							<a class="text-dark d-flex align-items-center gap-1"
							   id="userMenu"
							   data-bs-toggle="dropdown"
							   style="cursor: pointer;">
								<i class="bi bi-person fs-5"></i>
							</a>

							@await Component.InvokeAsync("UserMenu")

						</div>
					</div>

				</div>
			</div>
		</div>
	</nav>
</header>
<style>

	.custom-hover-menu .dropdown-menu {
		display: block !important;
		opacity: 0;
		visibility: hidden;
		transform: translate(20px, 15px);
		transition: all 0.3s ease-in-out;
		pointer-events: none;
		margin-top: 0;
		right: 0;
		left: auto;
		min-width: 200px;
	}

	.custom-hover-menu:hover .dropdown-menu {
		opacity: 1;
		visibility: visible;
		transform: translate(0, 0);
		pointer-events: auto;
	}

	.dropdown-item {
		transition: all 0.2s ease;
		border-radius: 4px;
	}

		.dropdown-item:hover {
			background-color: #f8f9fa;
			color: #007bff !important;
			padding-left: 20px;
		}

	.custom-hover-menu::after {
		content: "";
		position: absolute;
		width: 100%;
		height: 25px;
		bottom: -25px;
		right: 0; /* Đổi left thành right để khớp với lề mới */
	}

</style>
