@{
    ViewData["Title"] = "Trang Chủ";
    Layout = "_Layout";
}

<div id="heroCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
    <div class="carousel-inner rounded-4 shadow-sm">
        <div class="carousel-item active">
            <div class="bg-dark text-white d-flex align-items-center" style="height: 500px; background: url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1500&q=80') center/cover;">
                <div class="container py-5 text-center">
                    <h1 class="display-3 fw-bold">BST MÙA HÈ 2026</h1>
                    <p class="lead">Khám phá phong cách mới nhất với ưu đãi lên đến 50%.</p>
                    <a href="#new-arrivals" class="btn btn-light btn-lg px-5 rounded-pill fw-bold shadow">MUA NGAY</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row mb-5 text-center">
        <h2 class="fw-bold mb-4">Danh Mục Yêu Thích</h2>
        <div class="col-6 col-md-3 mb-3">
            <div class="category-card p-4 bg-white rounded-4 shadow-sm border-0 transition">
                <i class="bi bi-gender-male fs-1 text-primary"></i>
                <h5 class="mt-3">Thời Trang Nam</h5>
            </div>
        </div>
        <div class="col-6 col-md-3 mb-3">
            <div class="category-card p-4 bg-white rounded-4 shadow-sm border-0 transition">
                <i class="bi bi-gender-female fs-1 text-danger"></i>
                <h5 class="mt-3">Thời Trang Nữ</h5>
            </div>
        </div>
        <div class="col-6 col-md-3 mb-3">
            <div class="category-card p-4 bg-white rounded-4 shadow-sm border-0 transition">
                <i class="bi bi-watch fs-1 text-warning"></i>
                <h5 class="mt-3">Phụ Kiện</h5>
            </div>
        </div>
        <div class="col-6 col-md-3 mb-3">
            <div class="category-card p-4 bg-white rounded-4 shadow-sm border-0 transition">
                <i class="bi bi-emoji-smile fs-1 text-success"></i>
                <h5 class="mt-3">Trẻ Em</h5>
            </div>
        </div>
    </div>

    <div id="new-arrivals" class="mb-5 py-4">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="fw-bold mb-0">🆕 Sản phẩm mới về</h2>
                <p class="text-muted">Cập nhật xu hướng mỗi ngày từ Clothé Shop</p>
            </div>
            <a href="/Product" class="text-decoration-none fw-bold text-primary">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>

        @await Component.InvokeAsync("NewProduct")
    </div>

    <div class="rounded-5 bg-dark text-white p-5 mb-5 shadow-lg position-relative overflow-hidden">
        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-md-7">
                <h2 class="fw-bold display-5">Xả kho cuối mùa!</h2>
                <p class="lead opacity-75">Hàng trăm sản phẩm đang chờ đợi bạn với mức giá không tưởng.</p>
                <button class="btn btn-primary btn-lg rounded-pill px-5 mt-3 fw-bold">SĂN DEAL NGAY</button>
            </div>
        </div>
        <div class="position-absolute top-0 end-0 p-5 opacity-25">
            <i class="bi bi-bag-check" style="font-size: 10rem;"></i>
        </div>
    </div>

    <div id="best-sellers" class="mb-5 py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-2 text-uppercase" style="letter-spacing: 2px;">🔥 Top <span class="text-danger">Bán Chạy</span></h2>
            <div class="mx-auto bg-danger rounded" style="height: 4px; width: 60px;"></div>
            <p class="text-muted mt-3">Những sản phẩm được tin dùng nhất</p>
        </div>

        @await Component.InvokeAsync("BestSeller")
    </div>
</div>

<div class="bg-primary text-white py-5 mt-5 rounded-top-5">
    <div class="container text-center">
        <h3 class="fw-bold">Đăng ký nhận tin</h3>
        <p>Nhận mã giảm giá 10% cho đơn hàng đầu tiên của bạn!</p>
        <div class="row justify-content-center mt-3">
            <div class="col-md-6">
                <div class="input-group mb-3 shadow-sm rounded-pill overflow-hidden">
                    <input type="email" class="form-control border-0 px-4 py-3" placeholder="Email của bạn...">
                    <button class="btn btn-dark px-4 fw-bold">ĐĂNG KÝ</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .category-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .category-card:hover {
            transform: translateY(-8px);
            background-color: #f8f9fa !important;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
        }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    .rounded-5 {
        border-radius: 2rem !important;
    }

    .transition {
        transition: 0.3s;
    }
</style>