@model Clothes_shop.Models.Products

@{
    ViewData["Title"] = "Chi Tiết Sản Phẩm";
    Layout = "_Layout";
}


<div class="container mt-5">

    <div class="row g-5">

        <!-- Ảnh sản phẩm -->
        <div class="col-md-6">
            <img src="@Model.ImageUrl"
                 class="img-fluid w-100 rounded shadow-sm">
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="col-md-6 d-flex flex-column">

            <h2 class="fw-bold mb-3">@Model.Name</h2>

            <h3 class="mb-4">
                @Model.Price.ToString("N0") đ
            </h3>

            <p class="mb-2">
                <strong>Danh mục:</strong> @Model.Category?.Name
            </p>

            <p class="mb-3">
                <strong>Mô tả:</strong> @Model.Description
            </p>

            <p class="mb-4">
                <strong>Số lượng trong kho:</strong> @Model.quantity
            </p>

            <!-- Button -->
            <div class="d-flex gap-3 mt-4">

                <button class="btn btn-outline-dark btn-lg flex-fill">
                    Thêm vào giỏ
                </button>

                <button class="btn btn-dark btn-lg flex-fill">
                    Mua ngay
                </button>

            </div>

        </div>

    </div>

</div>