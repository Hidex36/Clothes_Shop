@model List<Clothes_shop.Models.Products>

@{
    ViewData["Title"] = "Wishlist";
    Layout = "_Layout";
}

<div class="container mt-5">

    <h2 class="fw-bold mb-4">My Wishlist</h2>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <h5 class="text-muted">Wishlist của bạn đang trống</h5>
            <a href="/Product" class="btn btn-dark mt-3">Xem sản phẩm</a>
        </div>
    }
    else
    {

        <table class="table align-middle">

            <thead class="border-bottom">
                <tr>
                    <th style="width:60px"></th>
                    <th style="width:120px">Product</th>
                    <th></th>
                    <th style="width:150px">Price</th>
                    <th style="width:250px"></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr class="border-bottom">

                        <!-- Nút Xóa -->
                        <td>

                            <form asp-controller="Account"
                                  asp-action="Toggle"
                                  method="post">

                                <input type="hidden"
                                       name="productId"
                                       value="@item.Id" />

                                <button type="submit"
                                        style="background:none;border:none;font-size:20px;">
                                    <i class="bi bi-x-lg"></i>
                                </button>

                            </form>

                        </td>

                        <!-- Ảnh -->
                        <td>
                            <img src="@item.ImageUrl"
                                 style="width:70px;height:70px;object-fit:cover">
                        </td>

                        <!-- Tên -->
                        <td class="fw-semibold">
                            @item.Name
                        </td>

                        <!-- Giá -->
                        <td class="fw-bold">
                            @item.Price.ToString("N0") đ
                        </td>

                        <!-- Buttons -->
                        <td>

                            <div class="d-flex gap-2">

                                <!-- Thêm vào giỏ -->
                                <form asp-controller="Cart"
                                      asp-action="Add"
                                      method="post">

                                    <input type="hidden"
                                           name="productId"
                                           value="@item.Id" />

                                    <button class="btn btn-dark">
                                        <i class="bi bi-cart-plus"></i>
                                        Add to cart
                                    </button>

                                </form>

                                <!-- Xem chi tiết -->
                                <a href="/Product/Details/@item.Id"
                                   class="btn btn-outline-dark">

                                    Read more

                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    }

</div>

<style>
    table tbody tr:hover {
        background: #f8f9fa;
    }
</style>